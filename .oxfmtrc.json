{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 180,
  "tabWidth": 2,
  "useTabs": false,
  "bracketSpacing": true,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "none",
  "endOfLine": "lf",
  "ignorePatterns": ["node_modules", "source_addons", "docs"]
}
